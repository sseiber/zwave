{
  "$id": "INetworkHealth",
  "$ref": "#/definitions/INetworkHealth",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "HealthState": {
      "enum": [
        "good",
        "fair",
        "poor"
      ],
      "type": "string"
    },
    "IHealthFactor": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "type": "string"
        },
        "impact": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "nodeId": {
          "type": "number"
        },
        "suggestion": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "impact"
      ],
      "type": "object"
    },
    "IHealthNoise": {
      "additionalProperties": false,
      "properties": {
        "average": {
          "type": "number"
        },
        "channels": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "current": {
          "type": "number"
        }
      },
      "required": [
        "current",
        "average",
        "channels"
      ],
      "type": "object"
    },
    "IHealthSample": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "string"
        },
        "errorRate": {
          "type": "number"
        },
        "messagesPerMinute": {
          "type": "number"
        },
        "noise": {
          "type": "number"
        },
        "responseMs": {
          "type": "number"
        },
        "score": {
          "type": "number"
        }
      },
      "required": [
        "at",
        "score",
        "errorRate",
        "messagesPerMinute"
      ],
      "type": "object"
    },
    "IHealthSweep": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "boolean"
        },
        "at": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "nodeId": {
          "type": "number"
        },
        "ok": {
          "type": "boolean"
        },
        "rtt": {
          "type": "number"
        }
      },
      "required": [
        "nodeId",
        "name",
        "active",
        "at",
        "ok"
      ],
      "type": "object"
    },
    "IHealthTraffic": {
      "additionalProperties": false,
      "properties": {
        "errorRate": {
          "type": "number"
        },
        "messagesPerMinute": {
          "type": "number"
        }
      },
      "required": [
        "messagesPerMinute",
        "errorRate"
      ],
      "type": "object"
    },
    "INetworkHealth": {
      "additionalProperties": false,
      "properties": {
        "advice": {
          "type": "string"
        },
        "devices": {
          "additionalProperties": false,
          "properties": {
            "offline": {
              "type": "number"
            },
            "responding": {
              "type": "number"
            },
            "total": {
              "type": "number"
            },
            "unmeasured": {
              "type": "number"
            }
          },
          "required": [
            "total",
            "responding",
            "offline",
            "unmeasured"
          ],
          "type": "object"
        },
        "factors": {
          "items": {
            "$ref": "#/definitions/IHealthFactor"
          },
          "type": "array"
        },
        "headline": {
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/definitions/INodeHealth"
          },
          "type": "array"
        },
        "noise": {
          "$ref": "#/definitions/IHealthNoise"
        },
        "sampledAt": {
          "type": "string"
        },
        "samples": {
          "items": {
            "$ref": "#/definitions/IHealthSample"
          },
          "type": "array"
        },
        "score": {
          "type": "number"
        },
        "state": {
          "$ref": "#/definitions/HealthState"
        },
        "sweep": {
          "$ref": "#/definitions/IHealthSweep"
        },
        "traffic": {
          "$ref": "#/definitions/IHealthTraffic"
        }
      },
      "required": [
        "score",
        "state",
        "headline",
        "advice",
        "factors",
        "samples",
        "sampledAt",
        "devices",
        "traffic",
        "nodes"
      ],
      "type": "object"
    },
    "INodeHealth": {
      "additionalProperties": false,
      "properties": {
        "dataRate": {
          "type": "number"
        },
        "dropRate": {
          "type": "number"
        },
        "hops": {
          "type": "number"
        },
        "lastSeen": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "nodeId": {
          "type": "number"
        },
        "rssi": {
          "type": "number"
        },
        "rtt": {
          "type": "number"
        },
        "state": {
          "$ref": "#/definitions/NodeHealthState"
        }
      },
      "required": [
        "nodeId",
        "name",
        "state"
      ],
      "type": "object"
    },
    "NodeHealthState": {
      "enum": [
        "good",
        "fair",
        "poor",
        "offline",
        "unknown"
      ],
      "type": "string"
    }
  }
}